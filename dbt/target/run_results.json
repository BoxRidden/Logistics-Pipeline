, "compiled": true, "compiled_code": "WITH shipments AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_shipments`\n),\n\nhubs AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`dim_hubs`\n),\n\nweather AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_weather`\n)\n\nSELECT\n    s.shipment_id,\n    s.tracking_code,\n    s.shipment_status,\n    s.destination_city,\n    h.hub_name,\n    h.hub_city,\n    \n    -- Metrics\n    w.temperature_celsius,\n    w.precipitation_mm,\n    w.weather_code,\n    \n    s.order_placed_at,\n    s.last_updated_at\nFROM shipments s\nLEFT JOIN hubs h ON s.hub_id = h.hub_id\nLEFT JOIN weather w \n    ON h.hub_city = w.hub_city \n    -- Matches weather to the day the order was placed\n    AND DATE(s.order_placed_at) = DATE(w.weather_captured_at)", "relation_name": "`logistics-500519`.`logistics_mart`.`fact_shipment_weather`", "batch_results": null}], "elapsed_time": 10.76393175125122, "args": {"validate_macro_args": false, "printer_width": 80, "warn_error_options": {"error": [], "warn": [], "silence": []}, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "export_saved_queries": false, "populate_cache": true, "strict_mode": false, "require_explicit_package_overrides_for_builtin_materializations": true, "quiet": false, "indirect_selection": "eager", "state_modified_compare_vars": false, "which": "build", "require_generic_test_arguments_property": true, "macro_debugging": false, "upload_to_artifacts_ingest_api": false, "partial_parse": true, "introspect": true, "target": "dev", "cache_selected_only": false, "require_nested_cumulative_type_params": false, "static_parser": true, "version_check": true, "require_ref_searches_node_package_before_root": false, "empty": false, "state_modified_compare_more_unrendered_values": false, "require_yaml_configuration_for_mf_time_spines": false, "log_format_file": "debug", "log_file_max_bytes": 10485760, "require_resource_names_without_spaces": true