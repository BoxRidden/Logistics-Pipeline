pleted_at": "2026-07-27T03:19:30.901304Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 4.287925720214844, "adapter_response": {"_message": "CREATE TABLE (608.0 rows, 48.6 KiB processed)", "code": "CREATE TABLE", "rows_affected": 608, "bytes_processed": 49778, "bytes_billed": 20971520, "location": "US", "project_id": "logistics-500519", "job_id": "2817e98e-0ff0-4e94-914a-1cb9cdfa14ad", "slot_ms": 3619}, "message": "CREATE TABLE (608.0 rows, 48.6 KiB processed)", "failures": null, "unique_id": "model.logistics_lakehouse.realtime_order_stats", "compiled": true, "compiled_code": "\n\nSELECT \n    s.hub_id AS store_id, \n    h.hub_name AS store_name,\n    s.shipment_status, \n    s.order_type, \n    TIMESTAMP_TRUNC(s.order_placed_at, HOUR) AS order_hour, \n    COUNT(s.shipment_id) AS order_count, \n    SUM(s.revenue_usd) AS total_revenue_usd, \n    SUM(s.revenue_vnd) AS total_revenue_vnd,\n    SUM(s.item_quantity) AS total_items_sold\nFROM \n    `logistics-500519`.`logistics_mart`.`stg_shipments` s\nLEFT JOIN \n    `logistics-500519`.`logistics_mart`.`dim_hubs` h ON s.hub_id = h.hub_id\nGROUP BY \n    1, 2, 3, 4, 5", "relation_name": "`logistics-500519`.`logistics_mart`.`realtime_order_stats`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-27T03:19:26.622136Z", "completed_at": "2026-07-27T03:19:26.634211Z"}, {"name": "execute", "started_at": "2026-07-27T03:19:26.634619Z", "completed_at": "2026-07-27T03:19:31.404124Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 4.787157297134399, "adapter_response": {"_message": "CREATE TABLE (836.0 rows, 89.5 KiB processed)", "code": "CREATE TABLE", "rows_affected": 836, "bytes_processed": 91626, "bytes_billed": 41943040, "location": "US", "project_id": "logistics-500519", "job_id": "553ad55d-70bd-4f42-85ea-6603b2bee35f", "slot_ms": 22952}, "message": "CREATE TABLE (836.0 rows, 89.5 KiB processed)", "failures": null, "unique_id": "model.logistics_lakehouse.fact_shipment_weather", "compiled": true, "compiled_code": "WITH shipments AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_shipments`\n),\n\nhubs AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`dim_hubs`\n),\n\ndrivers AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`dim_drivers`\n),\n\n-- Get only the single most recent weather record per city to avoid duplication\nlatest_weather AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`int_weather_consensus`\n    QUALIFY ROW_NUMBER() OVER(PARTITION BY UPPER(hub_city) ORDER BY weather_captured_at DESC) = 1\n)\n\nSELECT\n    s.shipment_id,\n    s.tracking_code,\n    s.shipment_status,\n    s.order_type,\n    s.product_category,\n    s.revenue_usd,\n    s.revenue_vnd,\n    s.item_quantity,\n    s.destination_city,\n    \n    -- Hub (Location) Data\n    h.hub_name AS store_name,\n    h.hub_id AS store_id,\n    h.latitude,\n    h.longitude,\n    CONCAT(h.latitude, ',', h.longitude) AS geo_location, -- Looker Studio map format\n    \n    -- Driver / Fleet Data\n    d.vehicle_type,\n    \n    -- Weather Data\n    w.temperature_celsius,\n    w.precipitation_mm,\n    w.weather_code AS weather_condition,\n    \n    -- Time Data\n    s.order_placed_at AS order_placed_at_utc,\n    s.last_updated_at AS last_updated_at_utc,\n    \n    -- Calculate Transit Time (in hours) only if delivered \n    CASE \n        WHEN s.shipment_status = 'Delivered' THEN \n            CASE \n                -- Severe Weather (Thunderstorms): 4 to 8 hours\n                WHEN w.weather_code IN (95, 96, 99) THEN ROUND(4.0 + (RAND() * 4.0), 1)\n                \n                -- Moderate Weather (Rain/Drizzle): 2 to 4 hours\n                WHEN w.weather_code IN (51, 53, 55, 61, 63, 65, 80, 81, 82) THEN ROUND(2.0 + (RAND() * 2.0), 1)\n                \n                -- Clear/Cloudy/Optimal: 0.5 to 1.5 hours\n                ELSE ROUND(0.5 + (RAND() * 1.0), 1) \n            END\n        ELSE NULL \n    END AS transit_time_hours\n\nFROM shipments s\nLEFT JOIN hubs h \n    ON s.hub_id = h.hub_id \nLEFT JOIN drivers d\n    ON s.driver_id = d.driver_id\nLEFT JOIN latest_weather w \n    ON UPPER(h.hub_city) = UPPER(w.hub_city)", "relation_name": "`logistics-500519`.`logistics_mart`.`fact_shipment_weather`", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-07-27T03:19:31.417373Z", "completed_at": "2026-07-27T03:19:31.436764Z"}, {"name": "execute", "started_at": "2026-07-27T03:19:31.437439Z", "completed_at": "2026-07-27T03:19:33.780071Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 2.371483564376831, "adapter_response": {"_message": "SELECT (1.0 rows, 6.5 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 6688, "bytes_billed": 10485760, "location": "US", "project_id": "logistics-500519", "job_id": "173b56ba-7b62-4534-8aa9-8b2b4afe42cf", "slot_ms": 31}, "message": null, "failures": 0, "unique_id": "test.logistics_lakehouse.not_null_fact_shipment_weather_shipment_id.018933c322", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect shipment_id\nfrom `logistics-500519`.`logistics_mart`.`fact_shipment_weather`\nwhere shipment_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-07-27T03:19:31.429116Z", "completed_at": "2026-07-27T03:19:31.439232Z"}, {"name": "execute", "started_at": "2026-07-27T03:19:31.439779Z", "completed_at": "2026-07-27T03:19:34.096612Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 2.6835484504699707, "adapter_response": {"_message": "SELECT (1.0 rows, 6.5 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 6688, "bytes_billed": 10485760, "location": "US", "project_id": "logistics-500519", "job_id": "48ac82bb-26f3-49fd-a89d-38c0158ecbef", "slot_ms": 29}, "message": null, "failures": 0,