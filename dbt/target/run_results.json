r", "compiled": true, "compiled_code": "WITH shipments AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_shipments`\n),\n\nhubs AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`dim_hubs`\n),\n\nweather AS (\n    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_weather`\n)\n\nSELECT\n    s.shipment_id,\n    s.tracking_code,\n    s.shipment_status,\n    s.destination_city,\n    h.hub_name,\n    h.hub_city,\n    \n    -- Metrics\n    w.temperature_celsius,\n    w.precipitation_mm,\n    w.weather_code,\n    \n    s.order_placed_at,\n    s.last_updated_at\nFROM shipments s\nLEFT JOIN hubs h ON s.hub_id = h.hub_id\nLEFT JOIN weather w \n    ON h.hub_city = w.hub_city \n    -- Matches weather to the day the order was placed\n    AND DATE(s.order_placed_at) = DATE(w.weather_captured_at)", "relation_name": "`logistics-500519`.`logistics_mart`.`fact_shipment_weather`", "batch_results": null}], "elapsed_time": 11.070618867874146, "args": {"show": false, "use_fast_test_edges": false, "populate_cache": true, "require_resource_names_without_spaces": true, "include_saved_query": false, "state_modified_compare_more_unrendered_values": false, "log_file_max_bytes": 10485760, "vars": {}, "indirect_selection": "eager", "static_parser": true, "print": true, "use_colors": true, "exclude_resource_types": [], "require_ref_searches_node_package_before_root": false, "validate_macro_args": false, "log_path": "/opt/airflow/dbt/logs", "partial_parse_file_diff": true, "version_check": true, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "resource_types": [], "warn_error_options": {"error": [], "warn": [], "silence": []}, "require_nested_cumulative_type_params": false, "log_format_file": "debug", "strict_mode": false, "partial_parse": true, "cache_selected_only": false, "select": [], "quiet": false, "state_modified_compare_vars": false, "empty": false, "skip_nodes_if_on_run_start_fails": false, "show_resource_report": false, "log_level": "i