  s.shipment_id,\n    s.tracking_code,\n    s.shipment_status,\n    s.destination_city,\n    h.hub_name,\n    h.hub_city,\n    w.temperature_celsius,\n    w.precipitation_mm,\n    w.weather_code,\n    s.order_placed_at,\n    s.last_updated_at\nFROM shipments s\nLEFT JOIN hubs h \n    ON s.hub_id = h.hub_id \n    AND s.order_placed_at >= h.valid_from \n    AND (s.order_placed_at < h.valid_to OR h.valid_to IS NULL)\nLEFT JOIN weather w \n    ON UPPER(h.hub_city) = UPPER(w.hub_city)\n    AND TIMESTAMP_TRUNC(s.order_placed_at, HOUR) = w.weather_captured_at", "relation_name": "`logistics-500519`.`logistics_mart`.`fact_shipment_weather`", "batch_results": null}], "elapsed_time": 8.601340055465698, "args": {"require_yaml_configuration_for_mf_time_spines": false, "require_explicit_package_overrides_for_builtin_materializations": true, "use_colors_file": true, "send_anonymous_usage_stats": true, "cache_selected_only": false, "validate_macro_args": false, "static_parser": true, "require_ref_searches_node_package_before_root": false, "partial_parse_file_diff": true, "favor_state": false, "partial_parse": true, "skip_nodes_if_on_run_start_fails": false, "require_unique_project_resource_names": false, "quiet": false, "printer_width": 80, "select": [], "introspect": true, "show_all_deprecations": false, "require_generic_test_arguments_property": true, "exclude": [], "use_colors": true, "log_level": "info", "write_json": true, "export_saved_queries": false, "log_level_file": "debug", "which": "build", "require_resource_names_without_spaces": true, "use_fast_test_edges": false, "log_format": "default", "source_freshness_run_project_hooks": true, "resource_types": [], "log_file_max_bytes": 10485760, "strict_mode": false, "version_check": true, "macro_debugging": false, "invocation_command": "dbt build --profiles-dir . --target dev", "exclude_resource_types": [], "upload_to_artifacts_ingest_api": false, "target": "dev", "show": false, "empty": false, "print": true, "require_nested_cu