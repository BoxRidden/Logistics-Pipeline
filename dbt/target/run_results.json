istics_mart`.`stg_weather`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-25T22:55:11.635505Z", "completed_at": "2026-06-25T22:55:11.637847Z"}, {"name": "execute", "started_at": "2026-06-25T22:55:11.638084Z", "completed_at": "2026-06-25T22:55:13.304959Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 1.6734085083007812, "adapter_response": {"_message": "CREATE VIEW (0 processed)", "code": "CREATE VIEW", "bytes_processed": 0, "bytes_billed": 0, "location": "US", "project_id": "logistics-500519", "job_id": "0f688f4d-534d-4f29-b6fa-4c41ade01574", "slot_ms": 0}, "message": "CREATE VIEW (0 processed)", "failures": null, "unique_id": "model.logistics_lakehouse.stg_shipments", "compiled": true, "compiled_code": "WITH raw_shipments AS (\n    SELECT\n        shipment_id,\n        tracking_code,\n        hub_id,\n        driver_id,\n        customer_city,\n        status,\n        created_at,\n        updated_at\n    FROM `logistics-500519`.`logistics_mart`.`shipments`\n)\n\nSELECT\n    shipment_id,\n    tracking_code,\n    hub_id,\n    driver_id,\n    UPPER(customer_city) AS destination_city,\n    COALESCE(status, 'Unknown') AS shipment_status,\n    created_at AS order_placed_at,\n    updated_at AS last_updated_at\nFROM raw_shipments", "relation_name": "`logistics-500519`.`logistics_mart`.`stg_shipments`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-25T22:55:12.240780Z", "completed_at": "2026-06-25T22:55:12.246896Z"}, {"name": "execute", "started_at": "2026-06-25T22:55:12.248789Z", "completed_at": "2026-06-25T22:55:15.252596Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 3.0170767307281494, "adapter_response": {"_message": "CREATE TABLE (3.0 rows, 108.0 Bytes processed)", "code": "CREATE TABLE", "rows_affected": 3, "bytes_processed": 108, "bytes_billed": 10485760, "location": "US", "project_id": "logistics-500519", "job_id": "bfcb84a1-e42c-4632-b12