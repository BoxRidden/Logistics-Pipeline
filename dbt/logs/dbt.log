    create or replace table `logistics-500519`.`logistics_mart`.`fact_shipment_weather`
      
    
    

    
    OPTIONS()
    as (
      WITH shipments AS (
    -- Reviewer Note: Assuming stg_shipments selects all underlying raw columns 
    -- including the newly added revenue, item_quantity, etc.
    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_shipments`
),

hubs AS (
    SELECT * FROM `logistics-500519`.`logistics_mart`.`dim_hubs`
),

weather AS (
    SELECT * FROM `logistics-500519`.`logistics_mart`.`stg_weather_consensus`
)

SELECT
    s.shipment_id,
    s.tracking_code,
    s.status AS shipment_status,       -- Required for Pie Chart & Cancelled Orders
    s.order_type,                      -- Required for Dine-in vs Delivery ratios
    s.product_category,                -- Required for Stacked Bar Chart
    s.revenue,                         -- Required for Total Revenue & Line Chart
    s.item_quantity,                   -- Required for Items Sold
    s.customer_city AS destination_city,
    h.hub_name AS store_name,          -- Aliased to match dashboard 'store_id/name' terminology
    h.hub_id AS store_id,
    w.temperature_celsius,             -- Required for Line Chart
    w.precipitation_mm,
    w.weather_code AS weather_condition, -- Required for Global Filter
    s.created_at AS order_placed_at_utc,
    s.updated_at AS last_updated_at_utc
FROM shipments s
LEFT JOIN hubs h 
    ON s.hub_id = h.hub_id 
    AND s.created_at >= h.valid_from 
    AND (s.created_at < h.valid_to OR h.valid_to IS NULL)
LEFT JOIN weather w 
    ON UPPER(h.hub_city) = UPPER(w.hub_city)
    AND TIMESTAMP_TRUNC(s.created_at, HOUR) = w.weather_captured_at
    );
  
