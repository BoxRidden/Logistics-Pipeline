  OPTIONS()
  as WITH raw_weather AS (
    SELECT
        hub_city,
        captured_at,
        -- Extracting values from the JSON structure depending on ingestion format
        temperature_2m,
        precipitation,
        weather_code
    FROM `logistics-500519`.`logistics_raw`.`weather_api_raw`
)

