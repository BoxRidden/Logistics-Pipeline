    UPPER(hub_city) AS hub_city,
    CAST(captured_at AS TIMESTAMP) AS weather_captured_at,
    CAST(temperature_2m AS FLOAT64) AS temperature_celsius,
    CAST(precipitation AS FLOAT64) AS precipitation_mm,
    weather_code
FROM raw_weather;


