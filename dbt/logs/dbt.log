  create or replace view `logistics-500519`.`logistics_mart`.`stg_shipments`
  OPTIONS()
  as WITH raw_shipments AS (
    SELECT
        shipment_id,
        tracking_code,
        hub_id,
        driver_id,
        customer_city,
        status,
        created_at,
        updated_at
    FROM `logistics-500519`.`logistics_raw`.`shipments`
)

SELECT
    shipment_id,
    tracking_code,
    hub_id,
    driver_id,
    UPPER(customer_city) AS destination_city,
