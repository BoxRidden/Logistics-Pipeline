  as WITH raw_shipments AS (
    SELECT
        shipment_id,
        tracking_code,
        hub_id,
        driver_id,
        customer_city,
        status,
        -- 1. Grab the new columns from the raw BigQuery table
        revenue,
        item_quantity,
        product_category,
