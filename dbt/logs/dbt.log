    SELECT
        shipment_id,
        tracking_code,
        hub_id,
        driver_id,
        customer_city,
        status,
        --Grab the new columns from the raw BigQuery table
        revenue,
        item_quantity,
        product_category,
        order_type,
        created_at,
        updated_at
    FROM `logistics-500519`.`logistics_raw`.`shipments`
)

SELECT
