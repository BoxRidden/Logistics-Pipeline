  OPTIONS()
  as WITH raw_shipments AS (
    SELECT
        shipment_id,
        tracking_code,
        hub_id,
        driver_id,
        customer_city,
        status,
        created_at,
        updated_at
    FROM `logistics_db`.`public`.`shipments`
)

SELECT
    shipment_id,
    tracking_code,
    hub_id,
    driver_id,
    UPPER(customer_city) AS destination_city,
